# Sao chep thanh .env roi doi gia tri. Khong commit .env.
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=marketlab
POSTGRES_DB=marketlab

# Cho API chay tren host (ngoai docker). Compose tu build DATABASE_URL tro ve service db.
DATABASE_URL=postgresql://marketlab:marketlab@127.0.0.1:5433/marketlab

# Port publish ra host cua stack docker. Doi neu may da chiem cac port nay.
DB_PORT=5433
API_PORT=8010
WEB_PORT=5173

VENUE=binance
BASE_TIMEFRAME=1h
HISTORY_DAYS=120
INGEST_INTERVAL_SECONDS=300
LIVE_ENABLED=true
