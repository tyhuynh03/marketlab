# Sao chep thanh .env roi doi gia tri. Khong commit .env.
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=marketlab
POSTGRES_DB=marketlab

# Cho API chay tren host (ngoai docker). Compose tu build DATABASE_URL tro ve service db.
DATABASE_URL=postgresql://marketlab:marketlab@127.0.0.1:5433/marketlab

# Port publish ra host cua stack docker. Doi neu may da chiem cac port nay.
DB_PORT=5433
API_PORT=8010
WEB_PORT=5173

VENUE=binance
BASE_TIMEFRAME=1h
HISTORY_DAYS=120
INGEST_INTERVAL_SECONDS=300
LIVE_ENABLED=true

# Agent mot phat (buoc 1 lo trinh agentic). Dien khoa that vao .env, khong commit.
# Provider OpenAI-compatible: Groq mac dinh, doi LLM_BASE_URL neu dung nha cung cap khac.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Model dieu phoi tool-calling (buoc 2); cau tra loi cuoi dung LLM_MODEL.
LLM_MODEL_TOOL=openai/gpt-oss-120b
# Ngan sach mot luot nam duoi 8.000 TPM (goi Free/Developer cua Groq).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=700
LLM_REASONING_EFFORT=low